# Source explicitly in the shell before running Flask. No secret is shipped.
YOUJU_DATABASE=youju.sqlite3
YOUJU_SOURCE_STORAGE=.data/source-blobs
# Provision a dedicated youju machine client; never reuse Xiaoman credentials.
ZDOG_AUTH_ISSUER=https://auth.example.com
ZDOG_AUTH_CLIENT_ID=
ZDOG_AUTH_CLIENT_SECRET=
# Grants come from zdog-auth userinfo.permissions; no local administrator allowlist.
# Explicit declaration: uv run flask --app youju auth-provision
# Assign youju-admin / youju:source:manage in zdog-auth, not in this file.
# Allowed origins are JSON arrays parsed by Flask.
YOUJU_ALLOWED_ORIGINS='["https://youjuh5.942295.xyz","https://youjuh5-h.942295.xyz","http://127.0.0.1:10089","http://localhost:10089"]'
# Production hosts are explicit; local hosts remain for loopback development.

# Optional foreground workers only; the HTTP API never launches model calls.
# YOUJU_PROVIDER=
# YOUJU_SMALL_MODEL=
# YOUJU_LARGE_MODEL=
YOUJU_TRUSTED_HOSTS='["youju.942295.xyz","youju-h.942295.xyz","127.0.0.1","localhost"]'

# Managed daemon settings. Installing/enabling services is an explicit operator action.
# Live classification/extraction/authoring can incur model costs once a source is submitted.
YOUJU_WORKERS_ENABLE_MODELS=false
YOUJU_PROVIDER=copilot
YOUJU_SMALL_MODEL=gpt-5.4-mini
YOUJU_LARGE_MODEL=gpt-5.4
# Native Recipe Flow extraction only; independent of classifier and author models.
YOUJU_FLOW_MODEL=gpt-5.4-nano
YOUJU_AUTHOR_MODEL=gpt-6.1-sol
YOUJU_RECIPE_RPC_URL=http://127.0.0.1:8090
# Generate two independent high-entropy secrets; never put these into client settings.
YOUJU_RECIPE_RPC_TOKEN=
YOUJU_RECIPE_CALLBACK_TOKEN=
# Use absolute private paths when enabling the managed daemons.
# YOUJU_RECIPE_CALLBACK_INBOX=/absolute/private/path/recipe-inbox.sqlite3
# YOUJU_LOCAL_CLASSIFIER=/absolute/private/path/local-page-model.json
YOUJU_WORKER_PASS_LIMIT=10
YOUJU_WORKER_POLL_SECONDS=3
YOUJU_ONBOARDING_LIMITS='{"max_resources":4000,"max_depth":100}'

# Optional asynchronous AI review of ambiguous resource classifications, not human review.
# Separate explicit source-lifetime budget; profile changes do not replenish it.
# Each worker pass dispatches at most one batch. No automatic retry after dispatch.
YOUJU_CLASSIFICATION_REVIEW_ENABLED=false
YOUJU_CLASSIFICATION_REVIEW_MODEL=gpt-6.1-sol
YOUJU_CLASSIFICATION_REVIEW_BATCH_SIZE=8
YOUJU_CLASSIFICATION_REVIEW_MAX_INPUT_BYTES=128000
YOUJU_CLASSIFICATION_REVIEW_MAX_BATCHES=3
