{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": [
      "node",
      "@tarojs/taro"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "config",
    "types",
    "tests"
  ]
}
