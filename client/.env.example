# Public endpoint only. Never place tokens or private keys in TARO_APP_* variables.
# Set this to an empty value to use the local /api proxy during H5 development.
# WeChat requires an HTTPS API endpoint registered in its domain configuration.
TARO_APP_API_BASE_URL=https://youju-h.942295.xyz

# Optional official WeChat code preview/upload. These are Node-side CI settings.
# Use this mini-program's own public AppID and keep its upload key private.
TARO_APP_ID=
MINIPROGRAM_PRIVATE_KEY_PATH=
MINIPROGRAM_VERSION=0.1.0
MINIPROGRAM_DESCRIPTION=Youju authentication and source administration
